<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" style="-fx-background-color: #F7FAFC; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.StudentController">
    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A365D;" text="Manage Students, Class Enrollment &amp; Tuition (UC 04)"/>
    <HBox spacing="10.0">
        <TextField fx:id="txtStudentCode" promptText="Student Code (e.g. S001)"/>
        <TextField fx:id="txtFullName" promptText="Full Name"/>
        <TextField fx:id="txtEmail" promptText="Email"/>
        <TextField fx:id="txtPhone" promptText="Phone"/>
        <DatePicker fx:id="dpDateOfBirth" promptText="Date of Birth"/>
    </HBox>
    <HBox spacing="10.0">
        <ComboBox fx:id="cboClass" promptText="Select Class"/>
        <TextField fx:id="txtTuitionFee" promptText="Tuition Fee"/>
        <TextField fx:id="txtDiscount" promptText="Discount (0)"/>
        <TextField fx:id="txtPaidAmount" promptText="Initial Paid Amount"/>
        <ComboBox fx:id="cboPaymentMethod" promptText="Payment Method"/>
        <Button fx:id="btnSave" onAction="#handleEnrollStudent" style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Enroll &amp; Save"/>
        <Button onAction="#handleRecordPayment" style="-fx-background-color: #38A169; -fx-text-fill: white; -fx-font-weight: bold;" text="Pay Tuition"/>
    </HBox>
    <TableView fx:id="tblStudentList" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCode" prefWidth="105.0" text="Student ID"/>
            <TableColumn fx:id="colFullName" prefWidth="180.0" text="Full Name"/>
            <TableColumn fx:id="colClass" prefWidth="150.0" text="Enrolled Class"/>
            <TableColumn fx:id="colTuitionFee" prefWidth="100.0" text="Tuition Fee"/>
            <TableColumn fx:id="colPaidAmount" prefWidth="100.0" text="Paid"/>
            <TableColumn fx:id="colPaymentStatus" prefWidth="125.0" text="Tuition Status"/>
            <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status"/>
        </columns>
    </TableView>
</VBox>
