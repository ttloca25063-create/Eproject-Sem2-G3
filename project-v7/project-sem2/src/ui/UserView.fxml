<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" style="-fx-background-color: #F7FAFC; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.UserController">
    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A365D;" text="Manage Users and Permissions (UC 02)"/>
    <HBox spacing="10.0">
        <TextField fx:id="txtSearch" prefWidth="250.0" promptText="Search username or full name..."/>
        <TextField fx:id="txtUsername" promptText="Username"/>
        <PasswordField fx:id="txtPassword" promptText="Password"/>
        <TextField fx:id="txtFullName" promptText="Full Name"/>
        <ComboBox fx:id="cboRole" promptText="Select Role"/>
        <ComboBox fx:id="cboStatus" promptText="Status"/>
    </HBox>
    <HBox spacing="10.0">
        <TextField fx:id="txtEmail" promptText="Email"/>
        <TextField fx:id="txtPhone" promptText="Phone"/>
        <TextField fx:id="txtAddress" prefWidth="200.0" promptText="Address"/>
        <Button fx:id="btnSave" onAction="#handleSaveUser" style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Add User"/>
        <Button fx:id="btnUpdate" onAction="#handleUpdateUser" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-font-weight: bold;" text="Update User"/>
        <Button fx:id="btnDelete" onAction="#handleDeleteUser" style="-fx-background-color: #E53E3E; -fx-text-fill: white;" text="Deactivate"/>
        <Button onAction="#handleClearUser" text="Clear"/>
    </HBox>
    <TableView fx:id="tblUserList" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colUserID" prefWidth="70.0" text="ID"/>
            <TableColumn fx:id="colUsername" prefWidth="150.0" text="Username"/>
            <TableColumn fx:id="colFullName" prefWidth="200.0" text="Full Name"/>
            <TableColumn fx:id="colRole" prefWidth="120.0" text="Role"/>
            <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status"/>
        </columns>
    </TableView>
    <VBox spacing="8.0" style="-fx-background-color: #EDF2F7; -fx-padding: 12; -fx-background-radius: 6;">
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Role Permissions:" style="-fx-font-weight: bold; -fx-text-fill: #2D3748;"/>
            <ComboBox fx:id="cboPermRole" promptText="Select Role" prefWidth="140.0"/>
            <Button onAction="#handleSavePermissions" style="-fx-background-color: #38A169; -fx-text-fill: white; -fx-font-weight: bold;" text="Save Permissions"/>
        </HBox>
        <FlowPane fx:id="flowPermissions" hgap="14.0" vgap="6.0"/>
    </VBox>
</VBox>
