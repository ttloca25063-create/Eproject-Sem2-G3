<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.SkillManagementController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    <Label text="Manage Skill (R, W, L, S)" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox spacing="10.0">
        <TextField fx:id="txtSkillCode" promptText="Code (R, W, L, S)" prefWidth="130.0"/>
        <TextField fx:id="txtSkillName" promptText="Skill Name (e.g., Reading)" prefWidth="200.0"/>
        <TextField fx:id="txtMinScore" promptText="Min Pass Score (e.g., 5.0)" prefWidth="160.0"/>
    </HBox>

    <HBox spacing="10.0">
        <Button fx:id="btnAddSkill" text="Add Skill" onAction="#handleAddSkill"/>
        <Button fx:id="btnUpdateSkill" text="Update Selected" onAction="#handleUpdateSkill"/>
        <Button fx:id="btnDeleteSkill" text="Delete Selected" onAction="#handleDeleteSkill"/>
        <Button fx:id="btnClearSkill" text="Clear" onAction="#handleClear"/>
    </HBox>

    <TableView fx:id="tblSkills" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colSkillID" text="ID" prefWidth="60.0"/>
            <TableColumn fx:id="colSkillCode" text="Code" prefWidth="100.0"/>
            <TableColumn fx:id="colSkillName" text="Skill Name" prefWidth="220.0"/>
            <TableColumn fx:id="colMinScore" text="Min Pass Score" prefWidth="140.0"/>
        </columns>
    </TableView>
</VBox>