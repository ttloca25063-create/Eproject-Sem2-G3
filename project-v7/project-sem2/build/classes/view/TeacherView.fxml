<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" style="-fx-background-color: #F7FAFC; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TeacherController">
    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A365D;" text="Manage Teachers &amp; Skill Types (UC 03)"/>
    <HBox spacing="10.0">
        <TextField fx:id="txtTeacherCode" promptText="Teacher Code (e.g. T001)"/>
        <TextField fx:id="txtFullName" promptText="Full Name"/>
        <TextField fx:id="txtEmail" promptText="Email"/>
        <TextField fx:id="txtPhone" promptText="Phone"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <TextField fx:id="txtDegree" promptText="Degree"/>
        <TextField fx:id="txtExperience" promptText="Experience"/>
        <ComboBox fx:id="cboProficiencyLevel" promptText="Proficiency Level"/>
        <ComboBox fx:id="cboStatus" promptText="Status"/>
        <Label style="-fx-font-weight: bold;" text="Skills (Required):"/>
        <CheckBox fx:id="chkListening" text="Listening"/>
        <CheckBox fx:id="chkSpeaking" text="Speaking"/>
        <CheckBox fx:id="chkReading" text="Reading"/>
        <CheckBox fx:id="chkWriting" text="Writing"/>
        <Button fx:id="btnSave" onAction="#handleSaveTeacher" style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Add Teacher"/>
        <Button onAction="#handleUpdateTeacher" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-font-weight: bold;" text="Update"/>
        <Button onAction="#handleDeleteTeacher" style="-fx-background-color: #E53E3E; -fx-text-fill: white;" text="Deactivate"/>
        <Button onAction="#handleClearTeacher" text="Clear"/>
    </HBox>
    <TableView fx:id="tblTeacherList" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCode" prefWidth="120.0" text="Code"/>
            <TableColumn fx:id="colFullName" prefWidth="200.0" text="Full Name"/>
            <TableColumn fx:id="colSkills" prefWidth="250.0" text="Assigned Skills"/>
            <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status"/>
        </columns>
    </TableView>
</VBox>
