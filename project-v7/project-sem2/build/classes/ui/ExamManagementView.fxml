<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.ExamManagementUIController"
      spacing="10" alignment="TOP_CENTER">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <Label text="QUẢN LÝ KỲ THI" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tblExams" prefHeight="240" prefWidth="850">
        <columns>
            <TableColumn fx:id="colID" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colCode" text="Mã" prefWidth="90"/>
            <TableColumn fx:id="colName" text="Tên kỳ thi" prefWidth="200"/>
            <TableColumn fx:id="colCertType" text="Loại chứng chỉ" prefWidth="130"/>
            <TableColumn fx:id="colExamDate" text="Ngày thi" prefWidth="100"/>
            <TableColumn fx:id="colDeadline" text="Hạn ĐK" prefWidth="100"/>
            <TableColumn fx:id="colFee" text="Lệ phí" prefWidth="100"/>
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="90"/>
        </columns>
    </TableView>

    <TitledPane text="Thông tin kỳ thi" expanded="true" prefWidth="850">
        <GridPane hgap="10" vgap="8">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="110"/><ColumnConstraints minWidth="200"/>
                <ColumnConstraints minWidth="110"/><ColumnConstraints minWidth="200"/>
            </columnConstraints>

            <Label text="Mã kỳ thi:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCode" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Tên kỳ thi:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <TextField fx:id="txtName" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Loại chứng chỉ:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbCertType" prefWidth="200" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Lệ phí:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="txtFee" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <Label text="Ngày thi:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dpExamDate" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Hạn đăng ký:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <DatePicker fx:id="dpDeadline" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

            <Label text="Địa điểm:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtLocation" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Trạng thái:" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
            <ComboBox fx:id="cbStatus" prefWidth="200" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
        </GridPane>
    </TitledPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Thêm mới" onAction="#handleAdd" prefWidth="100" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
        <Button text="Cập nhật" onAction="#handleUpdate" prefWidth="100" style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
        <Button text="Xóa" onAction="#handleDelete" prefWidth="90" style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
        <Button text="Làm mới" onAction="#handleClear" prefWidth="90"/>
    </HBox>

    <Label fx:id="lblMessage" style="-fx-font-weight: bold;"/>
</VBox>