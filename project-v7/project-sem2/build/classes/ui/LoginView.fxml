<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12.0" prefWidth="440.0" prefHeight="400.0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.LoginController"
      style="-fx-background-color: #F7FAFC;">
    <padding>
        <Insets top="25.0" right="35.0" bottom="25.0" left="35.0"/>
    </padding>

    <Label text="CERTIFICATE GENERATION SYSTEM" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1A365D;"/>
    <Label text="Sign in to your account" style="-fx-font-size: 13px; -fx-text-fill: #4A5568;"/>

    <VBox spacing="8.0" prefWidth="360.0">
        <Label text="Username" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #2D3748;"/>
        <TextField fx:id="txtUsername" promptText="Enter your username (e.g. admin, staff, student)" prefHeight="35.0" text="admin"/>

        <Label text="Password" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #2D3748;"/>
        <PasswordField fx:id="txtPassword" promptText="Enter your password" prefHeight="35.0" text="123456"/>

        <Label fx:id="lblStatus" textFill="#E53E3E" wrapText="true" style="-fx-font-size: 12px;"/>

        <Button fx:id="btnLogin" text="Login" maxWidth="Infinity" prefHeight="38.0" onAction="#handleLogin"
                style="-fx-background-color: #2B6CB0; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;"/>
    </VBox>

    <!-- Quick login guide -->
    <VBox spacing="4.0" style="-fx-background-color: #EDF2F7; -fx-padding: 10; -fx-background-radius: 6;" prefWidth="360.0">
        <Label text="Demo Accounts (Password: 123456):" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #2B6CB0;"/>
        <Label text="• Admin: admin (Full system access)" style="-fx-font-size: 11px; -fx-text-fill: #4A5568;"/>
        <Label text="• Staff: staff (Courses, Exams, Certificates)" style="-fx-font-size: 11px; -fx-text-fill: #4A5568;"/>
        <Label text="• Student: student (Exam registration, Results)" style="-fx-font-size: 11px; -fx-text-fill: #4A5568;"/>
    </VBox>
</VBox>
