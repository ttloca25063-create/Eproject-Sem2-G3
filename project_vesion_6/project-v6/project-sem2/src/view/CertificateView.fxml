<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.CertificateController" style="-fx-background-color: #F7FAFC; -fx-padding: 20;">
    <Label text="Check Eligibility &amp; Issue Certificate (UC 14 &amp; 17)"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A365D;"/>

    <!-- Verification & Issuance Card -->
    <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
        <HBox spacing="12.0" alignment="CENTER_LEFT">
            <Label text="Exam Result ID:" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
            <TextField fx:id="txtExamResultID" promptText="e.g. 1" prefWidth="110.0"/>
            <Button text="Verify Eligibility" onAction="#handleVerifyEligibility"
                    style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button fx:id="btnIssueCertificate" text="Generate &amp; Issue Certificate"
                    onAction="#handleIssueCertificate" disable="true"
                    style="-fx-background-color: #38A169; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button fx:id="btnRevokeCertificate" text="Revoke Selected"
                    onAction="#handleRevokeCertificate"
                    style="-fx-background-color: #E53E3E; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
        <Label fx:id="lblEligibilityStatus" text="Select a pending passed result below or enter Result ID"
               style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
        <Label fx:id="lblGeneratedCertNumber" text=""
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2B6CB0;"/>
    </VBox>

    <SplitPane dividerPositions="0.42" VBox.vgrow="ALWAYS">
        <VBox spacing="6.0">
            <Label text="Passed Candidates Pending Certificate:" style="-fx-font-weight: bold; -fx-text-fill: #2D3748;"/>
            <TableView fx:id="tblPendingResults" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPendingResultID" text="Res ID" prefWidth="55.0"/>
                    <TableColumn fx:id="colPendingName" text="Candidate" prefWidth="130.0"/>
                    <TableColumn fx:id="colPendingExam" text="Exam" prefWidth="130.0"/>
                    <TableColumn fx:id="colPendingScore" text="Score" prefWidth="55.0"/>
                    <TableColumn fx:id="colPendingPaid" text="Fee" prefWidth="75.0"/>
                </columns>
            </TableView>
        </VBox>
        <VBox spacing="6.0">
            <Label text="Issued Certificates:" style="-fx-font-weight: bold; -fx-text-fill: #2D3748;"/>
            <TableView fx:id="tblCertificates" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCertID" text="ID" prefWidth="45.0"/>
                    <TableColumn fx:id="colCertNumber" text="Certificate No." prefWidth="150.0"/>
                    <TableColumn fx:id="colCertType" text="Type" prefWidth="65.0"/>
                    <TableColumn fx:id="colCertCandidate" text="Holder" prefWidth="120.0"/>
                    <TableColumn fx:id="colCertScore" text="Score" prefWidth="55.0"/>
                    <TableColumn fx:id="colCertDate" text="Issue Date" prefWidth="90.0"/>
                    <TableColumn fx:id="colCertStatus" text="Status" prefWidth="70.0"/>
                </columns>
            </TableView>
        </VBox>
    </SplitPane>
</VBox>
