<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.EligibilityLookupController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    <Label text="Monthly or Course Eligibility Reports and Lookup" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox spacing="10.0">
        <TextField fx:id="txtKeyword" promptText="Enter Student Code, ID Number, or Certificate Number" prefWidth="340.0"/>
        <Button fx:id="btnSearch" text="Search Eligibility" onAction="#handleSearch"/>
        <Button fx:id="btnExportCsv" text="Export Report (CSV)" onAction="#handleExportCsv"/>
    </HBox>

    <TableView fx:id="tblResults" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFullName" text="Candidate Name" prefWidth="160.0"/>
            <TableColumn fx:id="colStudentCode" text="Student Code" prefWidth="110.0"/>
            <TableColumn fx:id="colExamName" text="Exam Name" prefWidth="160.0"/>
            <TableColumn fx:id="colAverageScore" text="Avg Score" prefWidth="90.0"/>
            <TableColumn fx:id="colResult" text="Result" prefWidth="90.0"/>
            <TableColumn fx:id="colCertNumber" text="Certificate Number" prefWidth="160.0"/>
        </columns>
    </TableView>
</VBox>