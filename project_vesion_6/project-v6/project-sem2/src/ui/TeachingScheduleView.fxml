<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" style="-fx-background-color: #F7FAFC; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TeachingScheduleController">
    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A365D;" text="Manage Teaching Schedules &amp; Instructor Assignment (UC 05)"/>
    <HBox spacing="10.0">
        <ComboBox fx:id="cboClass" promptText="Select Class"/>
        <ComboBox fx:id="cboTeacher" promptText="Select Teacher"/>
        <ComboBox fx:id="cboSkillType" promptText="Skill Type"/>
        <DatePicker fx:id="dpTeachingDate" promptText="Teaching Date"/>
        <TextField fx:id="txtStartTime" prefWidth="90.0" promptText="Start (18:00)"/>
        <TextField fx:id="txtEndTime" prefWidth="90.0" promptText="End (20:00)"/>
        <TextField fx:id="txtRoom" prefWidth="90.0" promptText="Room (R201)"/>
        <Button fx:id="btnSave" onAction="#handleSaveSchedule" style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Assign"/>
        <Button onAction="#handleDeleteSchedule" style="-fx-background-color: #E53E3E; -fx-text-fill: white; -fx-font-weight: bold;" text="Delete"/>
    </HBox>
    <TableView fx:id="tblScheduleList" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colClass" prefWidth="140.0" text="Class"/>
            <TableColumn fx:id="colTeacher" prefWidth="160.0" text="Teacher"/>
            <TableColumn fx:id="colSkill" prefWidth="100.0" text="Skill"/>
            <TableColumn fx:id="colDate" prefWidth="100.0" text="Date"/>
            <TableColumn fx:id="colStartTime" prefWidth="75.0" text="Start"/>
            <TableColumn fx:id="colEndTime" prefWidth="75.0" text="End"/>
            <TableColumn fx:id="colRoom" prefWidth="90.0" text="Room"/>
            <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status"/>
        </columns>
    </TableView>
</VBox>
