<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.ExamResultUIController"
      spacing="10" alignment="TOP_CENTER">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <Label text="QUẢN LÝ ĐIỂM &amp; KẾT QUẢ THI" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT" maxWidth="850">
        <Label text="Chọn kỳ thi:" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="cbExam" promptText="Chọn kỳ thi cần nhập điểm" prefWidth="320"/>
    </HBox>

    <HBox spacing="15" maxWidth="850">
        <!-- Bảng trái: Danh sách thí sinh -->
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Danh sách thí sinh đủ điều kiện thi:" style="-fx-font-weight: bold;"/>
            <TableView fx:id="tblResults" prefHeight="340" prefWidth="480">
                <columns>
                    <TableColumn fx:id="colRegID" text="Mã ĐK" prefWidth="65"/>
                    <TableColumn fx:id="colName" text="Họ tên thí sinh" prefWidth="170"/>
                    <TableColumn fx:id="colType" text="Loại" prefWidth="80"/>
                    <TableColumn fx:id="colTotal" text="Điểm TB" prefWidth="80"/>
                    <TableColumn fx:id="colStatus" text="Kết quả" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Khung phải: Nhập điểm chi tiết từng kỹ năng -->
        <VBox spacing="10" prefWidth="350" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 12;">
            <Label text="Chi tiết điểm kỹ năng" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Label fx:id="lblSelectedCandidate" text="Thí sinh: (Chưa chọn)" style="-fx-text-fill: #2980b9; -fx-font-weight: bold;"/>

            <VBox fx:id="vboxSkills" spacing="8" prefHeight="170"/>

            <Label text="Ghi chú:"/>
            <TextArea fx:id="txtNote" prefRowCount="2" wrapText="true"/>

            <Button text="Lưu điểm &amp; Xét kết quả" onAction="#handleSaveScore"
                    maxWidth="Infinity" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <Label fx:id="lblMessage" style="-fx-font-weight: bold;"/>
</VBox>