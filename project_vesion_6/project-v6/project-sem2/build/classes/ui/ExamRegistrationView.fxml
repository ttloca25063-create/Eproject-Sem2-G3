<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.ExamRegistrationUIController"
      spacing="10" alignment="TOP_CENTER">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <Label text="ĐĂNG KÝ THI CHỨNG CHỈ" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="120"/>
            <ColumnConstraints minWidth="280"/>
        </columnConstraints>

        <Label text="Kỳ thi:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbExam" promptText="Chọn kỳ thi" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="Loại thí sinh:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <HBox spacing="15" GridPane.rowIndex="1" GridPane.columnIndex="1">
            <RadioButton fx:id="rbInternal" text="Sinh viên (Miễn phí)" selected="true" toggleGroup="$tg"/>
            <RadioButton fx:id="rbExternal" text="Tự do (Đóng phí)" toggleGroup="$tg"/>
        </HBox>
        <fx:define><ToggleGroup fx:id="tg"/></fx:define>

        <Label fx:id="lblStudentCode" text="Mã sinh viên:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtStudentCode" promptText="VD: SV001" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Họ tên:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtFullName" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="CCCD:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtIdNumber" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Ngày sinh:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpDob" GridPane.rowIndex="5" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="SĐT:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPhone" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Email:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEmail" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Lệ phí:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <Label fx:id="lblFee" text="0 VNĐ" style="-fx-font-weight: bold; -fx-text-fill: #c0392b;" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Đăng ký" onAction="#handleRegister" prefWidth="110" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
        <Button text="Xác nhận thanh toán" onAction="#handleConfirmPayment" prefWidth="170" style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
        <Button text="Làm mới" onAction="#handleClear" prefWidth="90"/>
    </HBox>

    <Label fx:id="lblMessage" wrapText="true" maxWidth="450" style="-fx-font-style: italic;"/>

    <Label text="Danh sách đăng ký của kỳ thi:" style="-fx-font-weight: bold;"/>
    <TableView fx:id="tblRegistrations" prefHeight="220" prefWidth="750">
        <columns>
            <TableColumn fx:id="colRegID" text="Mã ĐK" prefWidth="70"/>
            <TableColumn fx:id="colName" text="Họ tên" prefWidth="160"/>
            <TableColumn fx:id="colType" text="Loại" prefWidth="90"/>
            <TableColumn fx:id="colFee" text="Lệ phí" prefWidth="100"/>
            <TableColumn fx:id="colPaid" text="Thanh toán" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>