<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.PeriodicTestController" style="-fx-background-color: #F7FAFC;">
    <padding>
        <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
    </padding>
    <Label text="Periodic Test &amp; Course Gradebook Management" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1A365D;"/>

    <HBox spacing="10.0">
        <TextField fx:id="txtClassID" promptText="Class ID (e.g., 1)" prefWidth="110.0"/>
        <ComboBox fx:id="cboSkillType" promptText="Select Skill" prefWidth="140.0"/>
        <TextField fx:id="txtTestName" promptText="Test Name (e.g., Midterm Reading)" prefWidth="210.0"/>
        <DatePicker fx:id="dpTestDate" promptText="Test Date"/>
        <Button fx:id="btnCreateTest" text="+ Create Test" onAction="#handleCreateTest"
                style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <HBox spacing="10.0">
        <TextField fx:id="txtStudentID" promptText="Student ID (e.g., 1)" prefWidth="120.0"/>
        <TextField fx:id="txtScore" promptText="Score (0 - 10)" prefWidth="110.0"/>
        <TextField fx:id="txtNote" promptText="Teacher Note" prefWidth="240.0"/>
        <Button fx:id="btnSaveScore" text="Save Student Score" onAction="#handleSaveScore"
                style="-fx-background-color: #38A169; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <TableView fx:id="tblTests" prefHeight="180.0">
        <columns>
            <TableColumn fx:id="colTestID" text="Test ID" prefWidth="70.0"/>
            <TableColumn fx:id="colClassID" text="Class ID" prefWidth="80.0"/>
            <TableColumn fx:id="colSkill" text="Skill" prefWidth="120.0"/>
            <TableColumn fx:id="colTestName" text="Test Name" prefWidth="260.0"/>
            <TableColumn fx:id="colTestDate" text="Test Date" prefWidth="130.0"/>
        </columns>
    </TableView>

    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <Tab text="Selected Test Scores">
            <VBox spacing="6.0" style="-fx-padding: 8 0 0 0;">
                <TableView fx:id="tblTestScores" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colScoreStudentID" text="Student ID" prefWidth="85.0"/>
                        <TableColumn fx:id="colScoreStudentCode" text="Student Code" prefWidth="115.0"/>
                        <TableColumn fx:id="colScoreStudentName" text="Full Name" prefWidth="200.0"/>
                        <TableColumn fx:id="colScoreValue" text="Score" prefWidth="85.0"/>
                        <TableColumn fx:id="colScoreNote" text="Note" prefWidth="260.0"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
        <Tab text="Full Course Gradebook (Bảng điểm toàn khóa)">
            <VBox spacing="8.0" style="-fx-padding: 8 0 0 0;">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Filter by Course:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="cboCourse" prefWidth="280.0"/>
                    <Button text="Refresh Gradebook" onAction="#handleLoadCourseGradebook"
                            style="-fx-background-color: #2B6CB0; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
                <TableView fx:id="tblCourseGradebook" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colGbCourse" text="Course" prefWidth="150.0"/>
                        <TableColumn fx:id="colGbClass" text="Class" prefWidth="130.0"/>
                        <TableColumn fx:id="colGbStudentCode" text="Student Code" prefWidth="95.0"/>
                        <TableColumn fx:id="colGbFullName" text="Full Name" prefWidth="150.0"/>
                        <TableColumn fx:id="colGbTestsTaken" text="Tests" prefWidth="55.0"/>
                        <TableColumn fx:id="colGbDetails" text="Periodic Test Scores" prefWidth="230.0"/>
                        <TableColumn fx:id="colGbAvgScore" text="Course Avg" prefWidth="90.0"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
